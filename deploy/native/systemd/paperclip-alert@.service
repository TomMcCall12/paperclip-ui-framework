[Unit]
Description=Telegram alert for failed unit %i
# No OnFailure= here: an alert unit that alerts on its own failure can loop.

[Service]
Type=oneshot
EnvironmentFile=/srv/paperclip/env/telegram.env
# Fixed location outside the release tree (see README.md) -- every other
# unit's OnFailure= points here, including paperclip.service itself, so
# this alert must still work even when the release that broke is the one
# this script would otherwise live inside.
ExecStart=/usr/local/lib/paperclip/scripts/telegram-alert.sh "%i"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip-alert
