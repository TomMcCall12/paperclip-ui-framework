# /srv/paperclip/env/rclone.env
# Copy from this template, then fill in the real remote. Never commit the
# real file. Loaded (optionally -- EnvironmentFile=-) by paperclip-backup and
# vault-drive-sync services.
#
# RCLONE_REMOTE is an rclone remote:path, e.g. "gdrive:Backups/paperclip".
# Configure the remote itself with `rclone config` as the paperclip user so
# its token lives in ~paperclip/.config/rclone/rclone.conf.

RCLONE_REMOTE=
RCLONE_VAULT_REMOTE=
