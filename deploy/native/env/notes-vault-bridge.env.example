# /srv/paperclip/env/notes-vault-bridge.env
# Copy from this template, then fill in the real token and vault path.
# Loaded by systemd/paperclip-notes-vault-bridge.service via EnvironmentFile=.
# See doc/NOTES-VAULT.md for what each variable does.

VAULT_ROOT=/srv/paperclip/data/vault
VAULT_BRIDGE_TOKEN=
VAULT_CHANGELOG_PATH=vault-changelog.md
VAULT_BRIDGE_PORT=8787
VAULT_OWNER_UID=
VAULT_OWNER_GID=
