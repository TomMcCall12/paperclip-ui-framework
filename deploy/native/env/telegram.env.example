# /srv/paperclip/env/telegram.env
# Copy from this template, then fill in the real token and chat id. Never
# commit the real file and never hard-code these values into any unit or
# script -- every OnFailure alert and the watchdog timer load them from here.
#
# Loaded by systemd/paperclip-alert@.service via EnvironmentFile=.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
