# /srv/paperclip/env/paperclip.env
# Copy from this template, then fill in real values. Never commit the real
# file. install-paperclip.sh seeds it only if it does not already exist, so
# re-running the installer never overwrites values already in place.
#
# Loaded by systemd/paperclip.service via EnvironmentFile=.

PORT=3100
HOST=0.0.0.0
PAPERCLIP_HOME=/srv/paperclip/data
SERVE_UI=true
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=https://zima-paperclip.tail702864.ts.net

# Required at runtime; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
