[Unit]
Description=Paperclip native backup run (triggered by paperclip-native-backup.timer)
RequiresMountsFor="/DATA/.media/External SSD"
OnFailure=paperclip-native-alert@%n.service

[Service]
Type=oneshot
User=paperclip
Group=paperclip
EnvironmentFile=/DATA/.media/External SSD/paperclip-native/env/paperclip-native.env
EnvironmentFile=-/DATA/.media/External SSD/paperclip-native/env/rclone.env
ExecStart=/DATA/.media/External SSD/paperclip-native/current/deploy/native/zimaos/scripts/paperclip-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip-native-backup
