[Unit]
Description=Paperclip control plane (native, ZimaOS)
Documentation=https://github.com/TomMcCall12/toms-lab
# The generated systemd mount-unit name for this path escapes the space as
# \x20 (DATA-.media-External\x20SSD.mount); using the path here (not the
# generated unit name) is the documented, stable way to express the same
# dependency -- systemd resolves it to that mount unit itself.
RequiresMountsFor="/DATA/.media/External SSD"
After=network-online.target
Wants=network-online.target
# No Before=, no early-boot target, no casaos-/zimaos- dependency, no
# change to var-lib-docker.mount or any existing unit: that exact shape of
# change created an ordering cycle on 5 Oct that silently deleted
# systemd-tmpfiles-setup.service, took out sshd, and left the board
# unreachable for 16.5 hours. This unit starts late, in ordinary userspace.
OnFailure=paperclip-native-alert@%n.service

[Service]
Type=simple
User=paperclip
Group=paperclip
WorkingDirectory=/DATA/.media/External SSD/paperclip-native/current
EnvironmentFile=/DATA/.media/External SSD/paperclip-native/env/paperclip-native.env
ExecStart=/DATA/.media/External SSD/paperclip-native/toolchain/node/bin/node --import ./server/node_modules/tsx/dist/loader.mjs server/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip-native
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
