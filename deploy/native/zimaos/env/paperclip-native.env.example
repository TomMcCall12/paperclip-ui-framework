# <root>/env/paperclip-native.env
# Copy from this template, then fill in real values. Never commit the real
# file. install-native-zimaos.sh seeds it only if it does not already
# exist, so re-running the installer never overwrites values already in
# place.
#
# Loaded by systemd/paperclip-native.service via EnvironmentFile=.
#
# PORT defaults to 3101 (not 3100) so the native service can run in
# parallel with the Docker container while it is being proved out.
# Cutting over to 3100 is a one-line change here plus `systemctl restart
# paperclip-native.service` -- never an edit to the unit file.
#
# MIGRATING AN EXISTING INSTANCE (not a brand-new install):
# For every secret below (BETTER_AUTH_SECRET, PAPERCLIP_AGENT_JWT_SECRET,
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET, PAPERCLIP_NOTES_VAULT_BRIDGE_TOKEN),
# do NOT generate a new value. Read the running instance's own value out of
# its live process environment -- e.g. `tr '\0' '\n' <
# /proc/<server-pid>/environ` -- and copy it across verbatim. Regenerating
# any of these invalidates every existing session and every existing agent
# API key: sessions are signed with BETTER_AUTH_SECRET and agent keys are
# validated against PAPERCLIP_AGENT_JWT_SECRET, so a new value does not
# "reset" anything gracefully, it just breaks every credential already
# issued. See README.md's "Migrating an existing instance" section for the
# full list and the notes-vault-bridge Docker-network caveat.

PORT=3101
HOST=0.0.0.0
SERVE_UI=true
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=https://zima-paperclip.tail702864.ts.net

# Everything below pins paths under <root> explicitly. Node, pnpm and
# Paperclip itself all default various caches/homes into $HOME or /var/tmp
# if left unset -- both are wrong on ZimaOS: $HOME may not exist for the
# paperclip user outside <root>, and /var + /tmp are tmpfs, wiped every
# boot. install-native-zimaos.sh fills in the real <root> path for all of
# these; do not delete any of them.
PAPERCLIP_HOME=<root>/data
HOME=<root>/home
TMPDIR=<root>/home/.tmp
XDG_CACHE_HOME=<root>/home/.cache
XDG_CONFIG_HOME=<root>/home/.config
XDG_DATA_HOME=<root>/home/.local/share
XDG_STATE_HOME=<root>/home/.local/state
npm_config_cache=<root>/home/.cache/npm
PNPM_HOME=<root>/home/.local/share/pnpm

# Read by deploy/native/scripts/vault-drive-sync.sh (reused unmodified from
# the Debian route -- it already takes VAULT_ROOT from the environment).
VAULT_ROOT=<root>/data/vault

# ---------------------------------------------------------------------------
# Required for a 1:1 migration of an existing instance
# ---------------------------------------------------------------------------
# Placeholders only below this line -- never put a real secret value in
# this committed template. Read every one of these out of the running
# instance's own process environment (see the header above); do not
# generate fresh values for a migration.

# Session signing. Required at runtime; generate with: openssl rand -hex 32
# -- but only for a BRAND-NEW instance. For a migration, copy the running
# instance's existing value: regenerating it logs out every signed-in user.
BETTER_AUTH_SECRET=

# Without this, every agent API key stops validating -- no agent can call
# the API at all. Copy the running instance's existing value for a
# migration; regenerating it revokes every agent key issued so far.
PAPERCLIP_AGENT_JWT_SECRET=

# Without this, signed tool actions break.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Without this, every stored credential in the database is undecryptable.
# Points at a file (on the live instance, a 46-byte file at the root of the
# data tree, not under data/secrets/) -- copy that file across, then point
# this at its new path under <root>, e.g. <root>/data/master.key.
PAPERCLIP_SECRETS_MASTER_KEY_FILE=
# Set to the running instance's value (true/false). Strict mode refuses to
# start if secrets can't be decrypted instead of silently degrading --
# leaving it unset changes that failure behavior for a migrated instance.
PAPERCLIP_SECRETS_STRICT_MODE=

# Attachments live here. The application's own default path is not under
# <root>, so a migrated instance must pin both explicitly or attachment
# storage will start empty instead of carrying over existing files.
PAPERCLIP_STORAGE_PROVIDER=local_disk
PAPERCLIP_STORAGE_LOCAL_DIR=<root>/data/storage

# Notes vault bridge. Without these, the notes vault is unreachable.
# PAPERCLIP_NOTES_VAULT_BRIDGE_URL's default value in the live Docker stack
# is the Docker-network DNS name http://notes-vault-bridge:8787, which a
# native service CANNOT resolve (it is not on that Docker network) -- this
# must be rewritten to a host-reachable address (e.g. http://127.0.0.1:8787
# or a Tailscale/LAN address), not copied verbatim from the Docker env.
PAPERCLIP_NOTES_VAULT_BRIDGE_URL=
PAPERCLIP_NOTES_VAULT_BRIDGE_TOKEN=
PAPERCLIP_NOTES_VAULT_COMPANY_ID=
PAPERCLIP_NOTES_VAULT_WRITER_AGENT_IDS=

# Instance identity. Determines where data lives: $PAPERCLIP_HOME/instances/
# $PAPERCLIP_INSTANCE_ID. Must match the live instance's existing value
# (normally "default") or the migrated data will not be found.
PAPERCLIP_INSTANCE_ID=default

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Carry these across too if the live instance sets them, to keep behavior
# identical; the application has defaults for each if left unset.

# Path to an optional instance-level JSON/YAML config file.
PAPERCLIP_CONFIG=
# Overrides/pins which model each adapter uses.
PAPERCLIP_ADAPTER_MODELS=
# Hostnames the server will accept inbound requests for.
PAPERCLIP_ALLOWED_HOSTNAMES=
# Controls how Better Auth derives its own base URL.
PAPERCLIP_AUTH_BASE_URL_MODE=
# Public URL used in outbound chat webhook payloads.
PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=
# Base URL the server/CLI use to call the Paperclip API itself.
PAPERCLIP_API_URL=
# Base URL Better Auth uses for callback/redirect links.
BETTER_AUTH_URL=
# Node runtime mode (e.g. production). Affects logging verbosity and
# framework-level dev conveniences.
NODE_ENV=
# Set to true to opt out of Paperclip's first-party telemetry. Carry the
# live instance's existing choice across; leaving it unset re-opts the
# migrated instance in by default.
PAPERCLIP_TELEMETRY_DISABLED=

# ---------------------------------------------------------------------------
# Host checks (TOM-690): network self-heal, network-path check, quiet-hours
# restart. Read by the root/paperclip units, not by the server. Leave them
# commented out to keep the defaults shown; README.md "Host safety net".
# ---------------------------------------------------------------------------
# PAPERCLIP_NET_IFACE=eth0
# PAPERCLIP_NET_HEAL_GRACE=300
# PAPERCLIP_NET_HEAL_STEP_INTERVAL=300
# Clean reboot as the last step when the port stays without an address.
# PAPERCLIP_NET_HEAL_REBOOT=0
# PAPERCLIP_NET_HEAL_REBOOT_AFTER=1800
# PAPERCLIP_NET_HEAL_REBOOT_MIN_INTERVAL=21600
# PAPERCLIP_NETWATCH_DNS_NAME=api.anthropic.com
# An empty value (uncommented) turns the internet check off.
# PAPERCLIP_NETWATCH_HTTPS_URL=https://api.anthropic.com/
# PAPERCLIP_QUIET_RESTART_MEM_MB=6144
# PAPERCLIP_QUIET_RESTART_SWAP_PCT=50
# PAPERCLIP_QUIET_RESTART_MAX_DAYS=3
# PAPERCLIP_QUIET_RESTART_WAIT=5400
